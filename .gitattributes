# 统一使用 LF 作为行尾符
* text=auto eol=lf

# 明确指定文本文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# 配置文件
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.prettierignore text eol=lf
.eslintignore text eol=lf

# 二进制文件（不转换行尾符）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
