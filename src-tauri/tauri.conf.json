{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "StoneKit",
	"version": "1.0.0",
	"identifier": "com.sty.stonekit",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "石头鱼的工具箱",
				"width": 1400,
				"height": 1000
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5174 http://localhost:1420; font-src 'self' data:; media-src 'self' asset:; object-src 'none'; frame-src 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"macOS": {
			"dmg": {
				"windowSize": {
					"width": 660,
					"height": 400
				},
				"appPosition": {
					"x": 180,
					"y": 170
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 170
				}
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
